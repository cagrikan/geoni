{
  "version": 2,
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/r/:slug"
    },
    {
      "source": "/s/:id",
      "destination": "/api/s/:id"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/isbirligi",
      "destination": "/isbirligi.html"
    },
    {
      "source": "/creator",
      "destination": "/isbirligi.html"
    },
    {
      "source": "/social-callback",
      "destination": "/social-callback.html"
    },
    {
      "source": "/rehber",
      "destination": "/rehber.html"
    },
    {
      "source": "/rehber/aeo-nedir",
      "destination": "/rehber/aeo-nedir.html"
    },
    {
      "source": "/rehber/llms-txt-nedir",
      "destination": "/rehber/llms-txt-nedir.html"
    },
    {
      "source": "/rehber/chatgpt-gorunurlugu",
      "destination": "/rehber/chatgpt-gorunurlugu.html"
    },
    {
      "source": "/rehber/markam-chatgptde-gorunmuyor",
      "destination": "/rehber/markam-chatgptde-gorunmuyor.html"
    },
    {
      "source": "/rehber/geo-nedir",
      "destination": "/rehber/geo-nedir.html"
    },
    {
      "source": "/rehber/ai-gorunurluk-araclari",
      "destination": "/rehber/ai-gorunurluk-araclari.html"
    },
    {
      "source": "/rehber/ai-gorunurluk-hizmeti-verenler",
      "destination": "/rehber/ai-gorunurluk-hizmeti-verenler.html"
    },
    {
      "source": "/guides/ai-visibility-tools",
      "destination": "/guides/ai-visibility-tools.html"
    },
    {
      "source": "/indir",
      "destination": "/indir.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/guides/what-is-aeo",
      "destination": "/guides/what-is-aeo.html"
    },
    {
      "source": "/guides/what-is-llms-txt",
      "destination": "/guides/what-is-llms-txt.html"
    },
    {
      "source": "/guides/chatgpt-visibility",
      "destination": "/guides/chatgpt-visibility.html"
    },
    {
      "source": "/guides/brand-not-in-chatgpt",
      "destination": "/guides/brand-not-in-chatgpt.html"
    },
    {
      "source": "/guides/what-is-geo",
      "destination": "/guides/what-is-geo.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/badge/:id",
      "destination": "/api/badge/:id"
    },
    {
      "source": "/ai-friendly",
      "destination": "/api/ai-friendly"
    },
    {
      "source": "/hesap-sil",
      "destination": "/hesap-sil.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/hesap-sil.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.geoni.ai https://auth.geoni.ai https://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
